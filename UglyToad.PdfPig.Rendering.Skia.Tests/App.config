<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <runtime>
    <!-- net462 only (ignored by modern .NET): SkiaSharp 3.x's net462 build references
         System.Runtime.CompilerServices.Unsafe 4.0.4.1 and calls Unsafe.SizeOf<T>() inside
         HandleDictionary's static initialisation (PlatformLock/NonAlertableWin32Lock), while the
         deployed Unsafe.dll is 6.0.3.0 (from the 6.1.2 package). AutoGenerateBindingRedirects
         does NOT emit a redirect for it — no compiled assembly in the closure references the
         newer version (the library's own Unsafe reference is elided by the compiler), so MSBuild
         sees no version conflict. Without this redirect the first SkiaSharp use throws
         FileLoadException (0x80131040) wrapped in a TypeInitializationException cascade
         (SKObject → SKColorSpace → HandleDictionary). Hosts with an AssemblyResolve fallback
         (e.g. `dotnet test`'s testhost) mask the bug; stricter hosts crash.
         If the System.Runtime.CompilerServices.Unsafe package is bumped, update the versions
         below to the new assembly version. -->
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.3.0" newVersion="6.0.3.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
